{
  "framework": "Playwright AI Agentic API Automation Framework",

  "project": {
    "name": "DummyJSON",
    "baseUrl": "https://dummyjson.com",

    "input": {
      "story": "input/dummyjson/api-story.md",
      "prompt": "input/dummyjson/api-prompt.md",
      "testData": "input/dummyjson/testdata.json",

      "swagger": "input/dummyjson/swagger/swagger.json",
      "postmanCollection": "input/dummyjson/postman/collection.json",
      "postmanEnvironment": "input/dummyjson/postman/environment.json"
    }
  },

  "features": {
    "useStory": true,
    "useSwagger": false,
    "usePostman": false,
    "useJira": false
  },

  "github": {
    "repository": "https://github.com/hammadafzal1/Playwright-AI-API-Automation-Framework",
    "defaultBranch": "main",
    "autoCommit": false,
    "autoPush": false
  }
}